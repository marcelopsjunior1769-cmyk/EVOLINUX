include README.md pyproject.toml .gitignore LICENSE LICENSING.md CHANGELOG.md CONTRIBUTING.md
recursive-include .github *.yml
recursive-include LICENSES *.txt
recursive-include third_party_licenses *.txt
recursive-include docs *.md
recursive-include tests *.py
recursive-include tests/fixtures *.txt
recursive-include include *.h
recursive-include kernel *.c Makefile README.md
recursive-include tools *.py
recursive-include tools *.sh
recursive-include research *.py *.md
prune build
prune dist
global-exclude __pycache__ *.py[cod] *.o *.ko *.cmd *.mod *.mod.c Module.symvers modules.order
